{
  "type": "webhook",
  "name": "record_preferences",
  "description": "Call this as soon as the caller has described what they want: bedrooms, neighbourhoods, budget, parking, or pets. Call it AGAIN any time they change or reprioritize. Do not wait until the end of the call. After it returns, read the speak field aloud. Use the returned session_id on every later tool call. Never invent a session_id.",
  "api_schema": {
    "url": "https://zipping-scarf-actress.ngrok-free.dev/agent/preferences",
    "method": "POST",
    "path_params_schema": [],
    "query_params_schema": [],
    "request_body_schema": {
      "id": "body",
      "type": "object",
      "description": "Preferences the caller just said. Only include fields they actually mentioned.",
      "required": true,
      "value_type": "llm_prompt",
      "properties": [
        {
          "id": "session_id",
          "type": "string",
          "description": "",
          "dynamic_variable": "session_id",
          "constant_value": "",
          "value_type": "dynamic_variable",
          "required": true,
          "enum": null
        },
        {
          "id": "caller_phone",
          "type": "string",
          "description": "Inbound caller. Filled from system__caller_id. Do not invent it.",
          "dynamic_variable": "system__caller_id",
          "constant_value": "",
          "value_type": "dynamic_variable",
          "required": false,
          "enum": null
        },
        {
          "id": "beds",
          "type": "integer",
          "description": "Number of bedrooms they want. Integer only. Omit if they did not say.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "baths",
          "type": "integer",
          "description": "Number of bathrooms they want. Integer only. Omit if they did not say.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "areas",
          "type": "string",
          "description": "Neighbourhoods they named, comma-separated, e.g. King West, Liberty Village.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "max_rent",
          "type": "integer",
          "description": "Maximum monthly rent in CAD. Integer only, no dollar sign.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "parking",
          "type": "boolean",
          "description": "True if they need parking. False if they said they do not. Omit if unsaid.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "pets",
          "type": "string",
          "description": "Exactly what they said: dog, cat, or none.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        },
        {
          "id": "priority_order",
          "type": "string",
          "description": "What matters most first, comma-separated, e.g. transit, price, parking. Only if they ranked things.",
          "dynamic_variable": "",
          "constant_value": "",
          "value_type": "llm_prompt",
          "required": false,
          "enum": null
        }
      ]
    },
    "request_headers": [],
    "content_type": "application/json",
    "auth_connection": null,
    "response_filter": null
  },
  "response_timeout_secs": 20,
  "follow_redirects": false,
  "follow_redirects_allowed_domains": [],
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "assignments": [
    {
      "source": "response",
