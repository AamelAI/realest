# Copy to .env and fill in. NEVER commit .env.

# ── Twilio (number + SMS) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +14165550123

# ── Voice transport ──────────────────────────────────────────────────────────
# TRANSPORT=stub  (default) scripted listing agents, no phone.
# TRANSPORT=voice real telephony. Then VOICE_PROVIDER picks the vendor:
#   openai_realtime = Twilio Media Streams bridge
#   elevenlabs      = managed ConvAI — see docs/ELEVENLABS.md Phase 1
TRANSPORT=stub
VOICE_PROVIDER=openai_realtime
# Listing-agent numbers, CSV or JSON array. start_calls zips these onto the
# shortlist (listing[i] → phone[i]) and stops when the list ends.
# DEMO_AGENT_PHONE=+14165550101,+14165550102
DEMO_AGENT_PHONE=
# Set to 1 if you are demoing outside 9–19 local.
FORCE_BUSINESS_HOURS=

# ── OpenAI — voice AND reasoning. Marquee sponsor; event supplies credits. ───
# Realtime API carries the calls (see scripts/spike_bridge.py); structured
# outputs drive Preferences + CallOutcome extraction.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# ── Gemini (works for /chat via the OpenAI-compat endpoint) ─────────────────
# Use model `gemini-flash-latest`; the pinned 2.5 ids are closed to new keys.
GEMINI_API_KEY=

# ── Which chat model /chat uses. Optional — each provider has a default. ────
CHAT_MODEL=

# ── ElevenLabs ConvAI (optional until VOICE_PROVIDER=elevenlabs) ─────────────
# Dashboard: elevenlabs.io → ElevenAgents. Runbook: docs/ELEVENLABS.md
ELEVENLABS_API_KEY=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_RENTER_AGENT_ID=
ELEVENLABS_LISTING_AGENT_ID=
# Demo-only. Set to 1 on venue Wi-Fi that intercepts HTTPS (self-signed MITM).
ELEVENLABS_INSECURE_SKIP_VERIFY=

# ── OpenRouter (fallback chain for ranking rationale + email drafting) ───────
OPENROUTER_API_KEY=
OPENROUTER_PRESET=              # preset slug holding the model fallback order

# ── Exa (card enrichment: transit, building reputation) ──────────────────────
EXA_API_KEY=

# ── Email fallback (optional) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Your FREE ngrok static domain — claim one at dashboard.ngrok.com/domains.
# Without it every restart gives a new URL and every in-flight call breaks.
NGROK_DOMAIN=your-name.ngrok-free.app
PUBLIC_URL=https://your-name.ngrok-free.app
# Where the SMS link points (Vercel deployment of web/)
WEB_URL=https://realest.vercel.app
