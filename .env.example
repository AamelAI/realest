# Copy to .env and fill in. NEVER commit .env.

# ── Voice provider (managed conversational telephony) ────────────────────────
VOICE_API_KEY=
VOICE_RENTER_AGENT_ID=          # agent that talks to the caller
VOICE_LISTING_AGENT_ID=         # agent that calls listing agents
VOICE_PHONE_NUMBER_ID=          # the imported Twilio number, provider-side id

# ── Twilio (number + SMS) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164, e.g. +14165550123

# ── OpenAI (reasoning: Preferences + CallOutcome structured outputs) ─────────
OPENAI_API_KEY=

# ── OpenRouter (fallback chain for ranking rationale + email drafting) ───────
OPENROUTER_API_KEY=
OPENROUTER_PRESET=              # preset slug holding the model fallback order

# ── Exa (card enrichment: transit, building reputation) ──────────────────────
EXA_API_KEY=

# ── Email fallback (optional) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Must be reachable by the voice provider. Local dev: ngrok http 8000
PUBLIC_URL=https://your-subdomain.ngrok-free.app
# Where the SMS link points (Vercel deployment of web/)
WEB_URL=https://realest.vercel.app
