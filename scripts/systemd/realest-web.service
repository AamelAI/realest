[Unit]
Description=Realest Next.js admin / shortlist UI
After=network.target realest.service
Wants=realest.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/base/web
Environment=PATH=/usr/bin:/bin
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BACKEND_URL=http://127.0.0.1:8000
ExecStart=/usr/bin/npm run start --prefix /home/ubuntu/base/web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
